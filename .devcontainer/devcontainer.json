{
  // Chipyard devcontainer. Auto-discovered by VS Code here under .devcontainer/.
  // Builds from the Dockerfile alongside this file (.devcontainer/Dockerfile),
  // which installs prerequisites (apt + conda) but does NOT clone Chipyard. The
  // host repo is bind-mounted in at /home/vscode/chipyard, so the build (which
  // writes a ~7GB .conda-env into the repo) lands in your local checkout and
  // persists on the host across container rebuilds.
  "name": "Chipyard",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".",
    "args": {
      "CHIPYARD_HASH": "48f904ae"
    }
  },
  "remoteUser": "vscode",
  "workspaceFolder": "/home/vscode/chipyard",
  "workspaceMount": "source=${localWorkspaceFolder},target=/home/vscode/chipyard,type=bind,consistency=cached",
  // `--init` reaps zombie processes from the long toolchain/sbt builds.
  // `--privileged` grants the loop-device access FireMarshal needs to
  // loop-mount and apply overlays to the buildroot Linux disk images
  // (build-setup.sh step 9). Without it, `mount -o loop` fails with
  // "Operation not permitted" / exit 32 (no /dev/loop*, no CAP_SYS_ADMIN).
  // Requires the host kernel to provide loop support (standard on Linux).
  "runArgs": ["--init", "--privileged"],
  "customizations": {
    "vscode": {
      "extensions": [
        "scalameta.metals",
        "scala-lang.scala",
        "ms-python.python"
      ],
      // Chipyard has dozens of (nested) submodules; building the toolchain writes
      // 10k+ files into source trees like riscv-gnu-toolchain/gdb. Stop VS Code's
      // Git extension from opening each submodule as its own repo (the source of
      // the "too many active changes, only a subset of Git features" warning).
      "settings": {
        "git.detectSubmodules": false,
        "git.ignoreLimitWarning": true
      }
    }
  }
  // To build Chipyard, open a terminal in the container and run:
  //   conda activate base && ./build-setup.sh riscv-tools
  // (left manual so image builds stay fast; the build takes 30-60+ min.)
}
